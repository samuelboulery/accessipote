# En-têtes servis par Netlify. Ce fichier est copié tel quel à la racine de dist/.

/*
  # Reprend à l'identique la CSP de la balise meta d'index.html, plus les deux
  # directives qu'une balise meta ne peut pas porter. Les deux politiques
  # s'appliquent alors ensemble : leur intersection, donc la plus stricte des
  # deux pour chaque directive. Elles doivent rester synchronisées — toute
  # modification de l'une doit être reportée sur l'autre.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Sans cette ligne, Netlify sert le manifeste en application/octet-stream.
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Les assets portent un hash dans leur nom : ils sont immuables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
