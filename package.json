{
  "packageManager": "pnpm@10.12.1",
  "name": "accessipote",
  "version": "1.0.0",
  "description": "Outil d'audit RGAA 4.1 : checklist interactive des 106 critères d'accessibilité numérique, hors ligne et sans compte, avec exports Markdown et PDF.",
  "keywords": [
    "rgaa",
    "rgaa-4-1",
    "accessibilite",
    "accessibility",
    "a11y",
    "audit",
    "wcag",
    "checklist",
    "react",
    "typescript"
  ],
  "homepage": "https://accessipote.fr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelboulery/accessipote.git"
  },
  "bugs": {
    "url": "https://github.com/samuelboulery/accessipote/issues"
  },
  "license": "MIT",
  "author": "Samuel Boulery (https://github.com/samuelboulery)",
  "engines": {
    "node": ">=20"
  },
  "//": "private: Accessipote est une application, pas une bibliothèque. Ce champ n'a aucun effet sur la découvrabilité GitHub et empêche une publication npm accidentelle.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "scrape:wcag": "node src/scripts/scrapeWcag.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "terser": "^5.50.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
